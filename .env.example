RAILS_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/railscms_development
SECRET_KEY_BASE=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
RAILS_SERVE_STATIC_FILES=true

# Production media storage (Cloudflare R2 or another S3-compatible provider)
ACTIVE_STORAGE_SERVICE=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
