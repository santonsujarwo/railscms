<div class="mx-auto max-w-7xl px-6 py-10">
  <div class="flex items-center justify-between"><div><h1 class="text-3xl font-semibold">Media Library</h1><p class="mt-2 text-sm text-slate-500">Manage uploaded images.</p></div><%= link_to "Upload media", new_admin_media_asset_path, class: "rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white" %></div>
  <% if @media_assets.any? %>
    <div class="mt-8 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4">
      <% @media_assets.each do |asset| %>
        <article class="overflow-hidden rounded-xl border bg-white">
          <% if asset.file.attached? %><%= image_tag asset.file.variant(resize_to_limit: [600, 450]), class: "aspect-[4/3] w-full object-cover", alt: asset.alt_text %><% end %>
          <div class="p-4"><p class="truncate text-sm font-medium"><%= asset.file.filename %></p><p class="mt-1 truncate text-xs text-slate-500"><%= asset.alt_text.presence || "Alt text not set" %></p><div class="mt-3 flex items-center justify-between text-sm"><%= link_to "Edit", edit_admin_media_asset_path(asset), class: "text-indigo-600" %><%= button_to "Delete", admin_media_asset_path(asset), method: :delete, form: { data: { turbo_confirm: "Delete this media file?" } }, class: "text-red-600" %></div></div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="mt-8 rounded-xl border border-dashed bg-white p-12 text-center"><p class="font-medium">No media uploaded yet</p><p class="mt-2 text-sm text-slate-500">Upload an image to start building your library.</p></div>
  <% end %>
</div>
