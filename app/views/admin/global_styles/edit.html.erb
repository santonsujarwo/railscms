<div class="mx-auto max-w-4xl px-6 py-10">
  <div class="mb-8"><h1 class="text-3xl font-semibold">Global Styles</h1><p class="mt-2 text-sm text-slate-500">Manage shared colors, typography, and layout tokens.</p></div>
  <%= form_with model: [:admin, @global_style], url: admin_global_style_path, method: :patch, class: "space-y-6" do %>
    <% tokens = @global_style.tokens || {} %>
    <% colors = tokens["colors"] || {} %>
    <% typography = tokens["typography"] || {} %>
    <% layout = tokens["layout"] || {} %>
    <section class="rounded-xl border border-slate-200 bg-white p-6">
      <h2 class="mb-5 text-lg font-semibold">Global Colors</h2>
      <div class="grid gap-5 sm:grid-cols-2">
        <% { "primary" => "Primary", "secondary" => "Secondary", "text" => "Text", "background" => "Background" }.each do |key, label| %>
          <div><%= label_tag "global_style_tokens_colors_#{key}", label, class: "mb-2 block text-sm font-medium" %><%= color_field_tag "global_style[tokens][colors][#{key}]", colors[key].presence || "#ffffff", id: "global_style_tokens_colors_#{key}", class: "h-11 w-20 rounded border-slate-300" %></div>
        <% end %>
      </div>
    </section>
    <section class="rounded-xl border border-slate-200 bg-white p-6">
      <h2 class="mb-5 text-lg font-semibold">Typography</h2>
      <div class="grid gap-5 sm:grid-cols-2">
        <% [["heading", "Heading"], ["body", "Body"]].each do |key, label| %>
          <div class="space-y-3">
            <h3 class="text-sm font-semibold"><%= label %></h3>
            <div><%= label_tag "global_style_tokens_typography_#{key}_font_family", "Font family", class: "mb-2 block text-sm" %><%= text_field_tag "global_style[tokens][typography][#{key}][font_family]", (typography.dig(key, "font_family") || ""), class: "w-full rounded-lg border-slate-300" %></div>
            <div><%= label_tag "global_style_tokens_typography_#{key}_font_weight", "Font weight", class: "mb-2 block text-sm" %><%= number_field_tag "global_style[tokens][typography][#{key}][font_weight]", (typography.dig(key, "font_weight") || 400), min: 100, max: 900, step: 100, class: "w-full rounded-lg border-slate-300" %></div>
          </div>
        <% end %>
      </div>
    </section>
    <section class="rounded-xl border border-slate-200 bg-white p-6">
      <h2 class="mb-5 text-lg font-semibold">Layout</h2>
      <div class="grid gap-5 sm:grid-cols-3">
        <% [["container_width", "Container width"], ["gutter", "Gutter"], ["section_spacing", "Section spacing"]].each do |key, label| %>
          <div><%= label_tag "global_style_tokens_layout_#{key}", label, class: "mb-2 block text-sm" %><%= text_field_tag "global_style[tokens][layout][#{key}]", layout[key], class: "w-full rounded-lg border-slate-300" %></div>
        <% end %>
      </div>
    </section>
    <%= submit_tag "Save global styles", class: "rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-medium text-white" %>
  <% end %>
</div>
