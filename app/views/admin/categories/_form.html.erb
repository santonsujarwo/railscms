<%= form_with model: [:admin, category], class: "space-y-5 rounded-xl border bg-white p-6" do |form| %>
  <% if category.errors.any? %><div class="rounded-lg bg-red-50 p-4 text-sm text-red-700"><%= category.errors.full_messages.to_sentence %></div><% end %>
  <div><%= form.label :name, class: "mb-2 block text-sm font-medium" %><%= form.text_field :name, class: "w-full rounded-lg border-slate-300" %></div>
  <div><%= form.label :slug, class: "mb-2 block text-sm font-medium" %><%= form.text_field :slug, class: "w-full rounded-lg border-slate-300" %></div>
  <div><%= form.label :description, class: "mb-2 block text-sm font-medium" %><%= form.text_area :description, rows: 3, class: "w-full rounded-lg border-slate-300" %></div>
  <div><%= form.label :parent_id, "Parent category", class: "mb-2 block text-sm font-medium" %><%= form.collection_select :parent_id, @parents, :id, :name, { include_blank: "None" }, class: "w-full rounded-lg border-slate-300" %></div>
  <label class="flex items-center gap-2 text-sm"><%= form.check_box :enabled %> Enabled</label>
  <div class="flex gap-3"><%= form.submit class: "rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-medium text-white" %><%= link_to "Cancel", admin_categories_path, class: "rounded-lg border px-5 py-2.5 text-sm" %></div>
<% end %>
