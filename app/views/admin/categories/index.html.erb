<div class="mx-auto max-w-7xl px-6 py-10">
  <div class="flex items-center justify-between"><h1 class="text-3xl font-semibold">Categories</h1><%= link_to "New category", new_admin_category_path, class: "rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white" %></div>
  <div class="mt-8 overflow-hidden rounded-xl border bg-white"><table class="min-w-full divide-y divide-slate-200"><thead class="bg-slate-50"><tr><th class="px-6 py-3 text-left text-xs uppercase text-slate-500">Name</th><th class="px-6 py-3 text-left text-xs uppercase text-slate-500">Slug</th><th class="px-6 py-3 text-left text-xs uppercase text-slate-500">Status</th><th></th></tr></thead><tbody class="divide-y divide-slate-100"><% @categories.each do |category| %><tr><td class="px-6 py-4 text-sm font-medium"><%= category.name %></td><td class="px-6 py-4 text-sm text-slate-500"><%= category.slug %></td><td class="px-6 py-4 text-sm text-slate-500"><%= category.enabled? ? "Enabled" : "Disabled" %></td><td class="px-6 py-4 text-right"><%= link_to "Edit", edit_admin_category_path(category), class: "text-sm text-indigo-600" %></td></tr><% end %></tbody></table></div>
</div>
