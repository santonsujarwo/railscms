<div class="mx-auto max-w-7xl px-6 py-10">
  <div class="flex items-center justify-between">
    <div><h1 class="text-3xl font-semibold">Posts</h1><p class="mt-2 text-sm text-slate-500">Manage articles and publishing status.</p></div>
    <%= link_to "New post", new_admin_post_path, class: "rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white" %>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border bg-white">
    <table class="min-w-full divide-y divide-slate-200">
      <thead class="bg-slate-50"><tr><th class="px-6 py-3 text-left text-xs uppercase text-slate-500">Title</th><th class="px-6 py-3 text-left text-xs uppercase text-slate-500">Category</th><th class="px-6 py-3 text-left text-xs uppercase text-slate-500">Status</th><th class="px-6 py-3"></th></tr></thead>
      <tbody class="divide-y divide-slate-100">
        <% @posts.each do |post| %><tr><td class="px-6 py-4 text-sm font-medium"><%= post.title %></td><td class="px-6 py-4 text-sm text-slate-500"><%= post.category&.name || "—" %></td><td class="px-6 py-4 text-sm text-slate-500"><%= post.status %></td><td class="px-6 py-4 text-right"><%= link_to "Edit", edit_admin_post_path(post), class: "text-sm font-medium text-indigo-600" %></td></tr><% end %>
      </tbody>
    </table>
  </div>
</div>
