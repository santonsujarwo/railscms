<div class="mx-auto max-w-7xl px-6 py-10">
  <div class="flex items-center justify-between">
    <div><h1 class="text-3xl font-semibold text-slate-900">Pages</h1><p class="mt-2 text-sm text-slate-500">Manage website pages.</p></div>
    <%= link_to "New page", new_admin_page_path, class: "rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white" %>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-slate-200 bg-white">
    <table class="min-w-full divide-y divide-slate-200">
      <thead class="bg-slate-50"><tr><th class="px-6 py-3 text-left text-xs font-semibold uppercase text-slate-500">Title</th><th class="px-6 py-3 text-left text-xs font-semibold uppercase text-slate-500">Slug</th><th class="px-6 py-3 text-left text-xs font-semibold uppercase text-slate-500">Status</th><th class="px-6 py-3"></th></tr></thead>
      <tbody class="divide-y divide-slate-100">
        <% @pages.each do |page| %>
          <tr><td class="px-6 py-4 text-sm font-medium"><%= page.title %></td><td class="px-6 py-4 text-sm text-slate-500">/<%= page.slug %></td><td class="px-6 py-4 text-sm text-slate-500"><%= page.status %></td><td class="px-6 py-4 text-right"><%= link_to "Edit", edit_admin_page_path(page), class: "text-sm font-medium text-indigo-600" %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
