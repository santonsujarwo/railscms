<div class="mx-auto max-w-5xl px-6 py-10">
  <div class="mb-8"><h1 class="text-3xl font-semibold">Edit page</h1><p class="mt-2 text-sm text-slate-500">Manage page details, SEO settings and flexible content sections.</p></div>
  <section class="rounded-xl border border-slate-200 bg-white p-6"><h2 class="mb-5 text-lg font-semibold">Page information</h2><%= render "form", page: @page %></section>

  <section class="mt-8">
    <div class="mb-4 flex items-center justify-between"><h2 class="text-xl font-semibold">Flexible Content</h2><span class="text-sm text-slate-500"><%= @sections.size %> sections</span></div>
    <div class="space-y-3">
      <% @sections.each_with_index do |section, index| %>
        <div class="flex flex-col gap-4 rounded-xl border border-slate-200 bg-white p-5 sm:flex-row sm:items-center sm:justify-between">
          <div><p class="font-medium"><%= section.section_definition.name %></p><p class="mt-1 text-xs text-slate-500">Position <%= index + 1 %> · <%= section.enabled? ? "Enabled" : "Disabled" %></p></div>
          <div class="flex flex-wrap items-center gap-3 text-sm">
            <%= button_to "↑", move_admin_page_section_path(@page, section, direction: "up"), method: :patch, disabled: index.zero?, class: "rounded border px-2 py-1 disabled:opacity-30" %>
            <%= button_to "↓", move_admin_page_section_path(@page, section, direction: "down"), method: :patch, disabled: index == @sections.length - 1, class: "rounded border px-2 py-1 disabled:opacity-30" %>
            <%= link_to "Edit fields & style", edit_admin_page_section_path(@page, section), class: "font-medium text-indigo-600" %>
            <%= button_to(section.enabled? ? "Disable" : "Enable", toggle_admin_page_section_path(@page, section), method: :patch, class: "text-slate-600") %>
            <%= button_to "Delete", admin_page_section_path(@page, section), method: :delete, form: { data: { turbo_confirm: "Delete this section?" } }, class: "text-red-600" %>
          </div>
        </div>
      <% end %>
    </div>
    <div class="mt-5 rounded-xl border border-dashed border-slate-300 bg-white p-5">
      <h3 class="mb-3 font-semibold">Add section</h3>
      <%= form_with url: admin_page_sections_path(@page), method: :post, class: "flex flex-col gap-3 sm:flex-row" do |form| %>
        <%= form.collection_select :section_definition_id, @section_definitions, :id, :name, { prompt: "Choose a section" }, class: "min-w-0 flex-1 rounded-lg border-slate-300" %>
        <%= form.submit "Add section", class: "rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-medium text-white" %>
      <% end %>
    </div>
  </section>
  <% if @revisions.present? %>
    <section class="mt-8 rounded-xl border bg-white p-6">
      <h2 class="mb-2 text-lg font-semibold">Revision history</h2>
      <p class="mb-4 text-xs text-slate-500">Restoring a revision replaces the page fields and its flexible content sections.</p>
      <ul class="space-y-3 text-sm text-slate-600">
        <% @revisions.each do |revision| %>
          <li class="flex flex-wrap items-center justify-between gap-3">
            <span><%= l(revision.created_at, format: :long) %> · <%= revision.event.humanize %> · <%= revision.user&.name || "System" %></span>
            <%= button_to "Restore", restore_admin_page_revision_path(@page, revision), method: :patch, form: { data: { turbo_confirm: "Restore this page revision? Current page fields and sections will be replaced." } }, class: "font-medium text-indigo-600" %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
