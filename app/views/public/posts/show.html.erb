<% content_for :title, @post.meta_title %>
<% content_for :meta_description, @post.meta_description %>
<% content_for :canonical_url, @post.canonical_url.presence || public_post_url(@post.slug) %>
<% content_for :robots, (@post.noindex? ? "noindex, nofollow" : "index, follow") %>
<article class="mx-auto max-w-3xl px-6 py-16">
  <% if @post.category %><p class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500"><%= @post.category.name %></p><% end %>
  <h1 class="text-4xl font-semibold tracking-tight"><%= @post.title %></h1>
  <% if @post.excerpt.present? %><p class="mt-5 text-xl leading-relaxed text-slate-600"><%= @post.excerpt %></p><% end %>
  <p class="mt-4 text-sm text-slate-500"><%= l(@post.published_at || @post.created_at, format: :long) %></p>
  <div class="prose prose-lg mt-10 max-w-none whitespace-pre-line"><%= @post.body %></div>
</article>
